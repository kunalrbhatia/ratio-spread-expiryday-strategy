# App Settings
PORT=3000
NODE_ENV=development

# Strategy Selection & Safety
STRATEGY=example
PAPER_MODE=true
STOP_LOSS_PERCENT=1.0
STOP_LOSS_MODE=MARGIN

# Angel One SmartAPI Credentials
API_KEY=YOUR_SMARTAPI_KEY
CLIENT_CODE=YOUR_CLIENT_CODE
CLIENT_PIN=YOUR_CLIENT_PIN
CLIENT_TOTP_PIN=YOUR_TOTP_SEED

# Telegram Notifications & Control (Optional)
USE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Slack Webhook Notifications (Optional)
USE_SLACK=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_SIGNING_SECRET=
